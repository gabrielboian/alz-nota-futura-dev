# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_TENANT_ID=your-azure-tenant-id

# Email (console backend for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ALZ Nota Futura <noreply@alzgraos.com.br>

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Database (SQLite for dev — comment out when using SQL Server)
# For SQL Server production, uncomment and set:
# DB_NAME=alz_nota_futura
# DB_USER=sa
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=1433

# Azure Blob Storage (NF XML archive — leave blank to fall back to local /media)
AZURE_BLOB_ACCOUNT_NAME=
AZURE_BLOB_ACCOUNT_KEY=
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=media

# RPA shared token (X-RPA-Token header) — long random string in production
RPA_API_TOKEN=dev-rpa-token-change-me
